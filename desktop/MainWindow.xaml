<Window x:Class="KeySaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeySaver" Width="1240" Height="790" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Language="ru-RU"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#EEF2F8"/>
        <SolidColorBrush x:Key="TintBrush" Color="#E1EAFB"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InsetBrush" Color="#F5F7FB"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="TextBrush" Color="#192338"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#515F76"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#5D6B83"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DCE3EE"/>
        <SolidColorBrush x:Key="ActiveLineBrush" Color="#CCDAFA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2455C6"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#EAF0FF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F0F4FA"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#A42737"/>
        <SolidColorBrush x:Key="NoteBadgeBrush" Color="#E5EEFF"/>
        <SolidColorBrush x:Key="NoteGlyphBrush" Color="#265BCC"/>
        <SolidColorBrush x:Key="CodeBadgeBrush" Color="#E0F2FC"/>
        <SolidColorBrush x:Key="CodeGlyphBrush" Color="#216891"/>
        <SolidColorBrush x:Key="EdgeBadgeBrush" Color="#DFF2F0"/>
        <SolidColorBrush x:Key="EdgeGlyphBrush" Color="#127173"/>
        <SolidColorBrush x:Key="MailBadgeBrush" Color="#ECEAFF"/>
        <SolidColorBrush x:Key="MailGlyphBrush" Color="#4E4BB8"/>

        <PathGeometry x:Key="KeyboardGeometry" Figures="M4,5.5 H20 Q21.5,5.5 21.5,7 V17 Q21.5,18.5 20,18.5 H4 Q2.5,18.5 2.5,17 V7 Q2.5,5.5 4,5.5 Z M6.5,9.5 h.1 M10,9.5 h.1 M14,9.5 h.1 M17.5,9.5 h.1 M6.5,13.5 h.1 M10,13.5 H14 M17.5,13.5 h.1"/>
        <PathGeometry x:Key="SettingsGeometry" Figures="M10,3.5 H14 L14.6,5.8 16,6.6 18.2,6 20.2,9.5 18.6,11.1 V12.7 L20.2,14.3 18.2,17.8 16,17.2 14.6,18 14,20.2 H10 L9.4,18 8,17.2 5.8,17.8 3.8,14.3 5.4,12.7 V11.1 L3.8,9.5 5.8,6 8,6.6 9.4,5.8 Z M14.6,11.9 A2.6,2.6 0 1 1 9.4,11.9 A2.6,2.6 0 1 1 14.6,11.9"/>
        <PathGeometry x:Key="MoonGeometry" Figures="M20,15 A8.2,8.2 0 0 1 9,4 A8.3,8.3 0 1 0 20,15 Z"/>
        <PathGeometry x:Key="SunGeometry" Figures="M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 M12,2.5 v2 M12,19.5 v2 M2.5,12 h2 M19.5,12 h2 M5.3,5.3 l1.4,1.4 M17.3,17.3 l1.4,1.4 M18.7,5.3 l-1.4,1.4 M6.7,17.3 l-1.4,1.4"/>
        <PathGeometry x:Key="CenterGeometry" Figures="M8.5,4.5 H4.5 V8.5 M15.5,4.5 H19.5 V8.5 M4.5,15.5 V19.5 H8.5 M15.5,19.5 H19.5 V15.5 M9,8.5 H15 Q15.5,8.5 15.5,9 V15 Q15.5,15.5 15,15.5 H9 Q8.5,15.5 8.5,15 V9 Q8.5,8.5 9,8.5 Z"/>
        <PathGeometry x:Key="InfoGeometry" Figures="M20.5,12 A8.5,8.5 0 1 1 3.5,12 A8.5,8.5 0 1 1 20.5,12 M12,11 V17 M12,7.5 h.1"/>
        <PathGeometry x:Key="SearchGeometry" Figures="M16.5,10.5 A6,6 0 1 1 4.5,10.5 A6,6 0 1 1 16.5,10.5 M15,15 L19.2,19.2"/>
        <PathGeometry x:Key="CalendarGeometry" Figures="M6,5.5 H18 Q20,5.5 20,7.5 V18 Q20,20 18,20 H6 Q4,20 4,18 V7.5 Q4,5.5 6,5.5 Z M8,3.5 V7.5 M16,3.5 V7.5 M4,10 H20 M8,14 h.1 M12,14 h.1 M16,14 h.1"/>
        <PathGeometry x:Key="ChevronGeometry" Figures="M7,10 L12,15 17,10"/>
        <PathGeometry x:Key="TrashGeometry" Figures="M4.5,7 H19.5 M9,7 L10,4 H14 L15,7 M18,7 L17.2,18 Q17.1,20 15.5,20 H8.5 Q6.9,20 6.8,18 L6,7 M10,10.5 V16.5 M14,10.5 V16.5"/>
        <PathGeometry x:Key="SortGeometry" Figures="M7,5 V19 M4,16 L7,19 10,16 M13,7 H20 M13,12 H18 M13,17 H16"/>
        <PathGeometry x:Key="CopyGeometry" Figures="M10,8 H18 Q20,8 20,10 V18 Q20,20 18,20 H10 Q8,20 8,18 V10 Q8,8 10,8 Z M16,8 V6 Q16,4 14,4 H6 Q4,4 4,6 V14 Q4,16 6,16 H8"/>
        <PathGeometry x:Key="MouseGeometry" Figures="M12,3 Q6.5,3 6.5,8.5 V15.5 Q6.5,21 12,21 Q17.5,21 17.5,15.5 V8.5 Q17.5,3 12,3 Z M12,3 V10 M6.5,10 H17.5"/>
        <PathGeometry x:Key="TabGeometry" Figures="M4,12 H16 M12,8 L16,12 12,16 M19,7 V17"/>
        <PathGeometry x:Key="EnterGeometry" Figures="M19,5 V10 Q19,13 16,13 H5 M9,9 L5,13 9,17"/>
        <PathGeometry x:Key="ClockGeometry" Figures="M20,12 A8,8 0 1 1 4,12 A8,8 0 1 1 20,12 M12,7.5 V12 L15,14"/>
        <PathGeometry x:Key="LockGeometry" Figures="M8,11 V7.5 A4,4 0 0 1 16,7.5 V11 M6.5,11 H17.5 V19.5 H6.5 Z"/>

        <Style x:Key="IconShape" TargetType="Path">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.55"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style x:Key="ActionIcon" TargetType="Path" BasedOn="{StaticResource IconShape}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource ActiveLineBrush}"/>
                                <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFace" Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryFace" Padding="{TemplateBinding Padding}" CornerRadius="7"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryFace" Property="Opacity" Value=".9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryFace" Property="Opacity" Value=".78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryFace" Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource ActiveLineBrush}"/>
                                <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFace" Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="18,15"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource NoteText}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Opacity" Value=".55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchField" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid>
                                <Path Style="{StaticResource IconShape}" Data="{StaticResource SearchGeometry}"
                                      Width="16" Height="16" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                <TextBlock x:Name="Placeholder" Visibility="Collapsed" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="34,0,10,0"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" Margin="34,0,10,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchField" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PasswordInput" TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordField" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordField" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboOption" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Option" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Option" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Option" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="Padding" Value="11,0,30,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboOption}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboField" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                                            <Path Style="{StaticResource IconShape}" Data="{StaticResource ChevronGeometry}"
                                                  Width="10" Height="6" HorizontalAlignment="Right" Margin="0,0,11,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboField" Property="BorderBrush" Value="{DynamicResource ActiveLineBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboField" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter VerticalAlignment="Center" IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Focusable="False" AllowsTransparency="True">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="4" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                                        Background="{DynamicResource SurfaceBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppRow" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SessionRow" TargetType="ListBoxItem" BasedOn="{StaticResource AppRow}">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="SelectionStripe" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"
                                    Width="3" Height="18" CornerRadius="0,2,2,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ActiveLineBrush}"/>
                                <Setter TargetName="SelectionStripe" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlyphBadge" TargetType="ContentControl">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <Viewbox>
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Блокнот">
                    <Setter Property="Foreground" Value="{DynamicResource NoteGlyphBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource NoteBadgeBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Visual Studio Code">
                    <Setter Property="Foreground" Value="{DynamicResource CodeGlyphBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource CodeBadgeBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Microsoft Edge">
                    <Setter Property="Foreground" Value="{DynamicResource EdgeGlyphBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource EdgeBadgeBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Outlook">
                    <Setter Property="Foreground" Value="{DynamicResource MailGlyphBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource MailBadgeBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AppIcon" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <ContentControl x:Name="Badge" Style="{StaticResource GlyphBadge}"
                                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                            Content="{Binding Glyph}" Tag="{Binding Name}"/>
                            <Image x:Name="FileIcon" Source="{Binding Icon}" Stretch="Uniform" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="FileIcon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="74,0,0,10">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" HorizontalAlignment="Left"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" Padding="0,14,0,0" Focusable="False"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTab" TargetType="TabItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabFace" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter x:Name="TabLabel" ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="TabFace" Property="BorderBrush" Value="{DynamicResource ActiveLineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="TabFace" Property="BorderBrush" Value="{DynamicResource ActiveLineBrush}"/>
                                <Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabFace" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeChoice" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeFace" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,10,0">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource SubtleBrush}" StrokeThickness="1"/>
                                    <Ellipse x:Name="ModeDot" Visibility="Collapsed" Fill="{DynamicResource AccentBrush}" Width="8" Height="8"/>
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeFace" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeFace" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ModeDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RuleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RuleFace" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="18,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="SwitchTrack" Grid.Column="1" Height="22" CornerRadius="11" VerticalAlignment="Center"
                                        Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource SubtleBrush}"
                                        BorderThickness="1" Padding="4,0">
                                    <Ellipse x:Name="SwitchDot" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Fill="{DynamicResource MutedBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RuleFace" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SwitchDot" Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
                                <Setter TargetName="SwitchDot" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RuleFace" Property="Opacity" Value=".55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="AppHeader" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="7,0,20,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="30" Height="30" Source="Assets/KeySaver.ico"/>
                    <TextBlock Text="KeySaver" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderButton}" ToolTip="Заблокировать" AutomationProperties.Name="Заблокировать" Click="LockInterface">
                        <Path Style="{StaticResource ActionIcon}" Data="{StaticResource LockGeometry}"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" ToolTip="Настройки" AutomationProperties.Name="Настройки" Click="OpenSettings">
                        <Path Style="{StaticResource ActionIcon}" Data="{StaticResource SettingsGeometry}"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" ToolTip="Переключить тему" AutomationProperties.Name="Переключить тему" Click="ToggleTheme">
                        <Path x:Name="ThemeIcon" Style="{StaticResource ActionIcon}" Data="{StaticResource MoonGeometry}"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" ToolTip="Центрировать окно" AutomationProperties.Name="Центрировать окно" Click="CenterWindow">
                        <Path Style="{StaticResource ActionIcon}" Data="{StaticResource CenterGeometry}"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" ToolTip="О программе" AutomationProperties.Name="О программе" Click="ShowAbout">
                        <Path Style="{StaticResource ActionIcon}" Data="{StaticResource InfoGeometry}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="HistoryView" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18.5*" MinWidth="190" MaxWidth="224"/>
                <ColumnDefinition Width="81.5*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="3,14,3,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="AppSearch" Style="{StaticResource SearchBox}" Tag="Поиск приложения" Margin="4,0,4,14"
                             AutomationProperties.Name="Поиск по названию приложения или имени файла" TextChanged="FilterChanged"/>
                    <ListBox x:Name="AppList" Grid.Row="1" Style="{StaticResource FlatList}" ItemContainerStyle="{StaticResource AppRow}"
                             AutomationProperties.Name="Приложения" SelectionChanged="FilterChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource AppIcon}" Width="24" Height="24"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="13" Foreground="{DynamicResource SubtleBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyAppSearch" Grid.Row="1" Text="Приложения не найдены" Foreground="{DynamicResource MutedBrush}"
                               Margin="12,48,10,0" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="34,16,34,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Panel}" CornerRadius="12" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="4*" MinWidth="144" MaxWidth="196"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextSearch" Style="{StaticResource SearchBox}" Tag="Поиск по тексту"
                                     AutomationProperties.Name="Поиск по тексту" TextChanged="FilterChanged"/>
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <ComboBox x:Name="DateFilter" Style="{StaticResource InputCombo}" SelectedIndex="0"
                                          Padding="33,0,28,0" AutomationProperties.Name="Дата" SelectionChanged="FilterChanged">
                                    <ComboBoxItem Tag="all" Content="Любая дата"/>
                                    <ComboBoxItem Tag="today" Content="Сегодня"/>
                                    <ComboBoxItem Tag="yesterday" Content="Вчера"/>
                                    <ComboBoxItem Tag="week" Content="Последние 7 дней"/>
                                    <ComboBoxItem Tag="range" Content="Выбрать период"/>
                                </ComboBox>
                                <Path Style="{StaticResource IconShape}" Data="{StaticResource CalendarGeometry}"
                                      Width="16" Height="16" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            </Grid>
                            <Button x:Name="ResetFiltersButton" Grid.Column="2" Style="{StaticResource RoundedButton}"
                                    Margin="8,0,0,0" Padding="9,5" Content="Сбросить" Visibility="Collapsed" Click="ResetFilters"/>
                        </Grid>
                        <StackPanel x:Name="DateRange" Visibility="Collapsed" Margin="0,10,0,0">
                            <WrapPanel>
                                <TextBlock Text="С" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker x:Name="FromDate" Width="144" AutomationProperties.Name="Начало периода" SelectedDateChanged="FilterChanged"/>
                                <TextBlock Text="по" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                <DatePicker x:Name="ToDate" Width="144" AutomationProperties.Name="Конец периода" SelectedDateChanged="FilterChanged"/>
                            </WrapPanel>
                            <TextBlock x:Name="RangeError" Style="{StaticResource StatusText}" Visibility="Collapsed"
                                       Text="Дата окончания должна быть не раньше даты начала."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="87*" MinWidth="190"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="135*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource PanelHeader}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButton}" IsEnabled="False"
                                                ToolTip="Удалить выбранные сессии" AutomationProperties.Name="Удалить выбранные сессии" Click="DeleteSessions">
                                            <Path Style="{StaticResource ActionIcon}" Data="{StaticResource TrashGeometry}" Width="16" Height="16"/>
                                        </Button>
                                        <Button x:Name="SortButton" Style="{StaticResource ToolbarButton}" ToolTip="Сначала новые"
                                                AutomationProperties.Name="Изменить порядок сортировки" Click="ToggleSort">
                                            <Path x:Name="SortIcon" Style="{StaticResource ActionIcon}" Data="{StaticResource SortGeometry}"
                                                  Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleY="1"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Сессии" Style="{StaticResource PanelTitle}"/>
                                        <TextBlock x:Name="SessionCount" Text="0 сессий" FontSize="13" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SubtleBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ListBox x:Name="SessionList" Grid.Row="1" Padding="10,0,10,8" Style="{StaticResource FlatList}"
                                     ItemContainerStyle="{StaticResource SessionRow}" SelectionMode="Extended"
                                     AutomationProperties.Name="Сессии" SelectionChanged="SessionSelectionChanged">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Items[0].DayText}" Margin="8,13,8,6" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Grid.RowSpan="2" Style="{StaticResource AppIcon}" Width="34" Height="34"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Margin="8,0,0,0" FontSize="13"
                                                       Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0" Text="{Binding Snippet}"
                                                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyHistory" Grid.Row="1" Visibility="Collapsed" Margin="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource GlyphBadge}" Content="{StaticResource SearchGeometry}" Width="40" Height="40"/>
                                <TextBlock x:Name="EmptyHistoryTitle" Text="Сессии не найдены" FontWeight="SemiBold" FontSize="17"
                                           TextAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock x:Name="EmptyHistoryHint" Style="{StaticResource NoteText}"
                                           Text="Попробуйте изменить фильтры или поисковый запрос." TextAlignment="Center"/>
                                <Button x:Name="EmptyHistoryReset" Style="{StaticResource RoundedButton}" Content="Сбросить фильтры" HorizontalAlignment="Center"
                                        Margin="0,10,0,0" Click="ResetFilters"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid x:Name="DetailContent" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource PanelHeader}" Padding="20,17">
                                    <DockPanel>
                                        <ContentControl Style="{StaticResource AppIcon}" Width="44" Height="44" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="DetailTitle" Text="{Binding AppName}" Style="{StaticResource PanelTitle}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Path}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock Text="{Binding DateTimeText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SubtleBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="20,18,20,20">
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource RoundedButton}" VerticalAlignment="Center" Click="CopyText">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource IconShape}" Stroke="{DynamicResource AccentBrush}"
                                                          Data="{StaticResource CopyGeometry}" Width="14" Height="14" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Копировать"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Сохранённый текст" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <TextBox Style="{StaticResource InputBox}" MinHeight="212" Padding="16" VerticalContentAlignment="Top"
                                                 Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                                 AutomationProperties.Name="Сохранённый текст"/>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,16,0,0">
                                            <UniformGrid Columns="2">
                                                <StackPanel>
                                                    <TextBlock Text="Начало" FontSize="13" Foreground="{DynamicResource SubtleBrush}"/>
                                                    <TextBlock Text="{Binding StartText}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Конец" FontSize="13" Foreground="{DynamicResource SubtleBrush}"/>
                                                    <TextBlock Text="{Binding EndText}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                            <StackPanel x:Name="EmptyDetail" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <ContentControl Style="{StaticResource GlyphBadge}" Content="{StaticResource KeyboardGeometry}" Width="40" Height="40"/>
                                <TextBlock Text="Нет выбранной сессии" FontWeight="SemiBold" FontSize="17" TextAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" Margin="34,16,34,24">
            <TabControl Style="{StaticResource SettingsTabs}" ItemContainerStyle="{StaticResource SettingsTab}"
                        AutomationProperties.Name="Разделы настроек" SelectedIndex="0">
                <TabItem Header="Область записи">
                    <Border Style="{StaticResource Panel}" MaxWidth="736" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Режим записи"/>
                            </Border>
                            <StackPanel Margin="16,12,16,8">
                                <RadioButton x:Name="AllMode" Style="{StaticResource ModeChoice}" GroupName="Scope" IsChecked="True"
                                             Tag="all" Content="Все приложения" Click="ChangeMode"/>
                                <RadioButton x:Name="ExceptMode" Style="{StaticResource ModeChoice}" GroupName="Scope"
                                             Tag="except" Content="Все, кроме выбранных" Click="ChangeMode"/>
                                <RadioButton x:Name="OnlyMode" Style="{StaticResource ModeChoice}" GroupName="Scope"
                                             Tag="only" Content="Только выбранные" Click="ChangeMode"/>
                            </StackPanel>
                            <Border x:Name="ScopeOptions" Visibility="Collapsed" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="0,1,0,0" Padding="20,16,20,20">
                                <StackPanel>
                                    <TextBlock x:Name="ScopeListTitle" Text="Выбранные приложения" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <ListBox x:Name="ScopeList" Style="{StaticResource FlatList}" MaxHeight="220" Margin="0,7,0,0"
                                             AutomationProperties.Name="Выбранные приложения" ItemContainerStyle="{StaticResource AppRow}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource RoundedButton}" Content="Убрать"
                                                            Margin="10,0,0,0" Tag="{Binding}" Click="RemoveScopeApp"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Список пока пуст." Foreground="{DynamicResource MutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=ScopeList}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,6" Text="Добавить приложение"/>
                                    <DockPanel LastChildFill="False">
                                        <ComboBox x:Name="ScopeChoice" Style="{StaticResource InputCombo}" Width="230" DisplayMemberPath="Name"
                                                  AutomationProperties.Name="Добавить приложение" SelectionChanged="ScopeChoiceChanged"/>
                                        <Button Content="Добавить" Style="{StaticResource RoundedButton}" Click="AddScopeApp" Margin="8,0,0,0"/>
                                        <Button Content="Выбрать .exe" Style="{StaticResource RoundedButton}" Click="BrowseScopeApp" Margin="8,0,0,0"/>
                                    </DockPanel>
                                    <StackPanel x:Name="CustomPathField" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Полный путь к .exe"/>
                                        <TextBox x:Name="CustomPathInput" Style="{StaticResource InputBox}" ToolTip="C:\Программы\Example.exe"
                                                 AutomationProperties.Name="Полный путь к .exe"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ScopeMessage" Style="{StaticResource StatusText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Правила сессии">
                    <Border Style="{StaticResource Panel}" MaxWidth="736" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Завершение сессии"/>
                            </Border>
                            <CheckBox x:Name="RecordingEnabled" Style="{StaticResource RuleSwitch}" IsChecked="True"
                                      AutomationProperties.Name="Настройка записи сессий" Click="ChangeRecordingEnabled">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource GlyphBadge}" Content="{StaticResource KeyboardGeometry}" Width="40" Height="40"/>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0,8,0">
                                        <TextBlock Text="Запись сессий"/>
                                        <TextBlock Text="Сохранять текст, набранный в других приложениях" FontSize="13" FontWeight="Normal"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="SessionRuleControls">
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                    <CheckBox x:Name="MouseRule" Style="{StaticResource RuleSwitch}" IsChecked="True"
                                              AutomationProperties.Name="Щелчок левой кнопкой мыши" Click="ChangeRules">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource GlyphBadge}" Content="{StaticResource MouseGeometry}" Width="40" Height="40"/>
                                            <TextBlock Text="Щелчок левой кнопкой мыши" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                    <CheckBox x:Name="TabRule" Style="{StaticResource RuleSwitch}" IsChecked="True" AutomationProperties.Name="Клавиша Tab" Click="ChangeRules">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource GlyphBadge}" Content="{StaticResource TabGeometry}" Width="40" Height="40"/>
                                            <TextBlock Text="Клавиша Tab" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                    <CheckBox x:Name="EnterRule" Style="{StaticResource RuleSwitch}" AutomationProperties.Name="Клавиша Enter" Click="ChangeRules">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource GlyphBadge}" Content="{StaticResource EnterGeometry}" Width="40" Height="40"/>
                                            <TextBlock Text="Клавиша Enter" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="IdleRule" Style="{StaticResource RuleSwitch}" IsChecked="True"
                                                  AutomationProperties.Name="Простой без ввода" Click="ChangeRules">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Style="{StaticResource GlyphBadge}" Content="{StaticResource ClockGeometry}" Width="40" Height="40"/>
                                                <TextBlock Text="Простой без ввода" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Margin="72,0,18,18">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Время простоя, сек." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="IdleSecondsInput" Style="{StaticResource InputBox}" Text="5" Width="84"
                                                         Margin="8,0,0,0" TextChanged="IdleSecondsChanged"
                                                         AutomationProperties.Name="Время простоя, секунд"/>
                                            </StackPanel>
                                            <TextBlock x:Name="IdleError" Style="{StaticResource StatusText}" Visibility="Collapsed"
                                                       Text="Введите целое число секунд от 1."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="18,22,18,8" Padding="0,14,0,6">
                                <CheckBox x:Name="Autostart" Style="{StaticResource RuleSwitch}"
                                          AutomationProperties.Name="Автозапуск Windows" Click="ChangeAutostart">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Автозапуск"/>
                                        <TextBlock Text="Запускать KeySaver при входе в Windows" FontSize="13" FontWeight="Normal"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Импорт и экспорт">
                    <Grid MaxWidth="992" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Style="{StaticResource PanelHeader}">
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="Экспорт истории"/>
                                </Border>
                                <StackPanel Margin="18">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Формат файла"/>
                                    <ComboBox x:Name="ExportFormat" Style="{StaticResource InputCombo}" SelectedIndex="0"
                                              AutomationProperties.Name="Формат файла" SelectionChanged="TransferOptionsChanged">
                                        <ComboBoxItem Content="JSON (.json)"/>
                                        <ComboBoxItem Content="Архив KeySaver (.keysaver)"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource NoteText}" Text="JSON сохраняется без пароля." x:Name="ExportJsonNote"/>
                                    <StackPanel x:Name="ArchiveOptions" Margin="0,12,0,0" Visibility="Collapsed">
                                        <CheckBox x:Name="ProtectArchive" Content="Защитить паролем" Foreground="{DynamicResource TextBrush}"
                                                  Click="TransferOptionsChanged"/>
                                        <StackPanel x:Name="ExportPasswordFields" Visibility="Collapsed" Margin="0,12,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль"/>
                                            <PasswordBox x:Name="ExportPassword" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Пароль"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Повторите пароль" Margin="0,10,0,6"/>
                                            <PasswordBox x:Name="ExportRepeat" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Повторите пароль"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Экспортировать" HorizontalAlignment="Left"
                                            MinHeight="38" Margin="0,16,0,0" Click="ExportHistory"/>
                                    <TextBlock x:Name="ExportStatus" Style="{StaticResource NoteText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Style="{StaticResource PanelHeader}">
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="Импорт истории"/>
                                </Border>
                                <StackPanel Margin="18">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Файл истории"/>
                                    <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="4">
                                        <DockPanel>
                                            <Button Style="{StaticResource RoundedButton}" MinHeight="28" Padding="8,3" Content="Выбрать файл" Click="ChooseImportFile"/>
                                            <TextBlock x:Name="ImportFileName" Text="Файл не выбран" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource NoteText}" Text="Форматы KeySaver: .json и .keysaver."/>
                                    <StackPanel x:Name="ImportPasswordField" Visibility="Collapsed" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль архива"/>
                                        <PasswordBox x:Name="ImportPassword" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Пароль архива"/>
                                    </StackPanel>
                                    <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="Импортировать" HorizontalAlignment="Left"
                                            MinHeight="38" Margin="0,16,0,0" IsEnabled="False" Click="ImportHistory"/>
                                    <TextBlock x:Name="ImportStatus" Style="{StaticResource NoteText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Пароль">
                    <Border Style="{StaticResource Panel}" Width="420" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHeader}">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Смена пароля"/>
                            </Border>
                            <StackPanel Margin="20">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Текущий пароль"/>
                                <PasswordBox x:Name="CurrentPassword" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Текущий пароль"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Новый пароль" Margin="0,12,0,6"/>
                                <PasswordBox x:Name="NewPassword" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Новый пароль"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Повторите новый пароль" Margin="0,12,0,6"/>
                                <PasswordBox x:Name="RepeatPassword" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Повторите новый пароль"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Сменить пароль" HorizontalAlignment="Left"
                                        MinHeight="38" Margin="0,16,0,0" Click="ChangePassword"/>
                                <TextBlock x:Name="PasswordStatus" Style="{StaticResource NoteText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
            <Button Style="{StaticResource RoundedButton}" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Top"
                    AutomationProperties.Name="Назад к истории" Click="CloseSettings"/>
        </Grid>
        <Border x:Name="LockOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource CanvasBrush}" Panel.ZIndex="20">
            <Border Style="{StaticResource Panel}" Width="380" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Интерфейс заблокирован" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Введите пароль, чтобы продолжить." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,14" TextWrapping="Wrap"/>
                    <PasswordBox x:Name="UnlockPassword" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Пароль блокировки" KeyDown="UnlockPasswordKey"/>
                    <TextBlock x:Name="UnlockError" Style="{StaticResource StatusText}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Разблокировать" HorizontalAlignment="Left"
                            MinHeight="38" Margin="0,16,0,0" Click="UnlockInterface"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
